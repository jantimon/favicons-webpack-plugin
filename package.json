{
  "name": "favicons-webpack-plugin",
  "version": "6.1.0-alpha.0",
  "description": "Let webpack generate all your favicons and icons for you",
  "main": "src/index.js",
  "files": [
    "src/"
  ],
  "scripts": {
    "declarations": "rimraf src/cache.d.ts src/hash.d.ts src/index.d.ts src/logger.d.ts src/oracle.d.ts src/url.d.ts && tsc -p ./tsconfig.json",
    "test": "c8 ava --timeout 10m --no-worker-threads",
    "update-snapshots": "npm run test -- -u",
    "fmt": "prettier --write src test",
    "fmt:check": "prettier --check src test",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "prepublishOnly": "npm run declarations"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jantimon/favicons-webpack-plugin.git"
  },
  "keywords": [
    "webpack",
    "plugin",
    "html-webpack-plugin",
    "webapp",
    "pwa",
    "manifest",
    "favicon",
    "icon",
    "png",
    "svg"
  ],
  "author": "Jan Nicklas <j.nicklas@me.com> (https://github.com/jantimon)",
  "contributors": [
    "Bruno Dutra <brunocodutra@gmail.com> (https://github.com/brunocodutra)",
    "Jan Nicklas <j.nicklas@me.com> (https://github.com/jantimon)",
    "Andrey Kutejko <andy128k@gmail.com> (https://github.com/andy128k)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jantimon/favicons-webpack-plugin/issues"
  },
  "homepage": "https://github.com/jantimon/favicons-webpack-plugin",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ava": "^7.0.0",
    "c8": "^11.0.0",
    "diffable-html": "^6.0.1",
    "eslint": "^10.4.0",
    "favicons": "^7.3.0",
    "get-folder-size": "^5.0.0",
    "globals": "^17.6.0",
    "html-webpack-plugin": "^5.5.0",
    "image-size": "^1.0.2",
    "prettier": "^3.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "webpack": "^5.78.0"
  },
  "dependencies": {
    "find-root": "^1.1.0",
    "parse-author": "^2.0.0"
  },
  "peerDependencies": {
    "favicons": "^7.0.1",
    "webpack": "^5.0.0"
  },
  "optionalDependencies": {
    "html-webpack-plugin": "^5.5.0"
  },
  "overrides": {
    "c8": {
      "yargs": "18.0.0"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=16"
  }
}

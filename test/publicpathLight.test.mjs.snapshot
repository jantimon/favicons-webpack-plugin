exports[`public path light > should take the public path into account 1`] = `
{
  "files": [
    "assets/favicon.png",
    "index.html",
    "main.js"
  ],
  "content": [
    {
      "assetName": "assets/favicon.png",
      "content": "png 874x989"
    },
    {
      "assetName": "index.html",
      "content": "\\n<!doctype html>\\n<html>\\n  <head>\\n    <meta charset=\\"utf-8\\">\\n    <title>\\n      Webpack App\\n    </title>\\n    <link\\n      rel=\\"icon\\"\\n      href=\\"/public/path/assets/favicon.png\\"\\n    >\\n    <script\\n      defer=\\"defer\\"\\n      src=\\"/public/path/main.js\\"\\n    >\\n    </script>\\n  </head>\\n  <body>\\n  </body>\\n</html>\\n"
    }
  ]
}
`;

